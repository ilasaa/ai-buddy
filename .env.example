# Local prototype only. Choose your own database password.
POSTGRES_USER=ai_buddy
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_DB=ai_buddy
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
SESSION_MINUTES=60
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# DEMO_PASSWORD is read from the shell by the seed script, not from this file.

# Docker demo users: intern/mentor/manager@ai-buddy.example.
# Only sets passwords when creating users; existing passwords are preserved.
DEMO_PASSWORD=Buddy-demo-2026!

# OpenAI-compatible Chat Completions API; server only, never VITE_*.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Legacy fallback when LLM_API_KEY / LLM_MODEL are empty:
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=45
CHAT_MAX_MESSAGE_CHARS=3000
CHAT_HISTORY_MESSAGES=8
CHAT_HISTORY_CHARS=12000
CHAT_DAILY_LIMIT=30
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_LOCAL_ONLY=true
# Default cache: .cache/huggingface in project root (ignored by Git)
RAG_TOP_K=5
# Measured on knowledge/evaluation.json for the unchanged demo corpus.
# Recalibrate after editing documents or replacing the embedding model.
RAG_MIN_SCORE=0.824426
RAG_CONTEXT_CHARS=8000
