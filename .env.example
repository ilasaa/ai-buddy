# Local prototype only. Choose your own database password.
POSTGRES_USER=ai_buddy
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_DB=ai_buddy
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
SESSION_MINUTES=60
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
# Docker передаёт DEMO_PASSWORD в seed; существующие пароли не меняются.
DEMO_PASSWORD=replace-with-demo-password

# DeepSeek: server only. Never put this key in VITE_* variables.
# LLM_* имеют приоритет над совместимыми DEEPSEEK_*
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=45
CHAT_MAX_MESSAGE_CHARS=3000
CHAT_HISTORY_MESSAGES=8
CHAT_HISTORY_CHARS=12000
CHAT_DAILY_LIMIT=30
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_LOCAL_ONLY=true
# Default cache: .cache/huggingface in project root (ignored by Git)
RAG_TOP_K=5
# Measured on knowledge/evaluation.json for the unchanged demo corpus.
# Recalibrate after editing documents or replacing the embedding model.
RAG_MIN_SCORE=0.824128
RAG_CONTEXT_CHARS=8000
